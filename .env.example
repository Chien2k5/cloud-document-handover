# Bucket backup riêng cho vận hành; backend không tự nạp file .env.
BACKUP_BUCKET=

# Chỉ dùng giá trị giả trong file này.
# Credential thật được cấu hình riêng, không commit.

# Backend Spring Boot S3/Lambda
DB_URL=jdbc:postgresql://localhost:5432/handover
DB_USERNAME=handover
DB_PASSWORD=
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true
PROJECT_QUOTA_BYTES=1073741824
# Chỉ local: đặt khi muốn tạo 4 tài khoản demo; không dùng trên AWS.
LOCAL_DEMO_PASSWORD=
# Upload backend; .env is not loaded automatically by Spring Boot.
UPLOAD_BUCKET=
UPLOAD_S3_ENABLED=false
AWS_REGION=
UPLOAD_TTL_SECONDS=300
UPLOAD_EXPIRY_DELAY_MS=30000
