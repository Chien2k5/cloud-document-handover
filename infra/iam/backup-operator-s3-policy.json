{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadPostgresDumpsInDedicatedBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET/postgres/*"
    },
    {
      "Sid": "ListBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET"
    },
    {
      "Sid": "VerifyPinnedObjectVersionsAfterRestore",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_UPLOAD_BUCKET/uploads/*",
        "arn:aws:s3:::REPLACE_UPLOAD_BUCKET/results/*"
      ]
    }
  ]
}
